# Переменные для docker compose (скопировать в .env и поправить).
# Файл .env читается docker compose автоматически.

# Домен сайта. Используется в конфиге nginx (server_name) и при выпуске сертификата.
# Сертификат выпускается сразу на DOMAIN и www.DOMAIN.
DOMAIN=mindasengine.uz

# Email для Let's Encrypt (уведомления об истечении сертификата).
CERTBOT_EMAIL=admin@mindasengine.uz

# Часовой пояс контейнеров.
TZ=Europe/Moscow
